# Copy to .env and fill in. Never commit .env.

# Sarvam AI (voice: STT, TTS, LLM fallback)
SARVAM_API_KEY=
# Optional overrides. Defaults live in voice/config.py and are UNVERIFIED:
# check model names and prices against docs.sarvam.ai.
# SARVAM_BASE_URL=https://api.sarvam.ai
# SARVAM_STT_MODEL=saarika:v2.5
# SARVAM_TTS_MODEL=bulbul:v2
# SARVAM_LLM_MODEL=sarvam-m
# SARVAM_TTS_SPEAKER=anushka
# SARVAM_STT_INR_PER_AUDIO_HOUR=30
# SARVAM_TTS_INR_PER_10K_CHARS=15
# SARVAM_LLM_INR_PER_1K_TOKENS=0

# PostgreSQL + PostGIS
POSTGRES_USER=daari
POSTGRES_PASSWORD=
POSTGRES_DB=daari
DATABASE_URL=postgresql+asyncpg://daari:CHANGE_ME@localhost:5432/daari

# Redis (live positions, pub/sub, Celery broker)
REDIS_URL=redis://localhost:6379/0

# Valhalla routing service
VALHALLA_URL=http://localhost:8002

# Auth
JWT_SIGNING_KEY=

# Cost guard: alert when Sarvam spend per driver per day exceeds this (INR)
COST_GUARD_INR_PER_DRIVER_DAY=5
