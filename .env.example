# Copy to .env and fill in. Never commit .env.

# Sarvam AI (voice: STT, TTS, LLM fallback)
SARVAM_API_KEY=
# Optional overrides. Defaults live in voice/config.py (checked against
# docs.sarvam.ai on 2026-11-05; pay-as-you-go prices excl. GST).
# SARVAM_BASE_URL=https://api.sarvam.ai
# SARVAM_STT_MODEL=saaras:v4
# SARVAM_TTS_MODEL=bulbul:v4-flash
# SARVAM_LLM_MODEL=sarvam-105b
# Per-language voice (bulbul:v4-flash IDs are language-specific):
# SARVAM_TTS_SPEAKER_KN=chaitra_kn_conversation
# SARVAM_TTS_SPEAKER_HI=ritu_hi_conversation
# SARVAM_TTS_SPEAKER_EN=simran_en_customer
# One voice for all languages (replaces the per-language defaults):
# SARVAM_TTS_SPEAKER=
# SARVAM_STT_INR_PER_AUDIO_HOUR=29.40
# SARVAM_TTS_INR_PER_10K_CHARS=10
# SARVAM_LLM_INR_PER_1M_INPUT_TOKENS=15
# SARVAM_LLM_INR_PER_1M_OUTPUT_TOKENS=60

# PostgreSQL + PostGIS
POSTGRES_USER=daari
POSTGRES_PASSWORD=
POSTGRES_DB=daari
DATABASE_URL=postgresql+asyncpg://daari:CHANGE_ME@localhost:5432/daari

# Redis (live positions, pub/sub, Celery broker)
REDIS_URL=redis://localhost:6379/0

# Valhalla routing service
VALHALLA_URL=http://localhost:8002

# Auth
JWT_SIGNING_KEY=

# Cost guard: alert when Sarvam spend per driver per day exceeds this (INR)
COST_GUARD_INR_PER_DRIVER_DAY=5
