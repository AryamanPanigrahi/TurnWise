<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fitsSystemWindows="true" android:orientation="vertical">

    <org.osmdroid.views.MapView android:id="@+id/map"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="4" />

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="5">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">

            <TextView android:id="@+id/banner" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="64dp" android:gravity="center_vertical" android:text="@string/tap_map"
                android:textColor="@color/info" android:textSize="22sp" android:textStyle="bold" />
            <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/not_started" android:textColor="@color/muted" android:textSize="13sp" />

            <EditText android:id="@+id/server" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:hint="@string/server_hint" android:importantForAutofill="no"
                android:inputType="textUri" android:minHeight="48dp" />
            <EditText android:id="@+id/token" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="@string/token_hint" android:importantForAutofill="no"
                android:inputType="textPassword" android:minHeight="48dp" />
            <Spinner android:id="@+id/lang" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="48dp" />

            <Button android:id="@+id/start" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="56dp" android:text="@string/start_trip" android:textAllCaps="false" />
            <Button android:id="@+id/end" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="56dp" android:text="@string/end_trip" android:textAllCaps="false" />

            <Button android:id="@+id/ask_branch" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="56dp" android:text="@string/ask_branch" android:textAllCaps="false" android:layout_marginTop="12dp" />
            <Button android:id="@+id/ask_side" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="56dp" android:text="@string/ask_side" android:textAllCaps="false" />
            <Button android:id="@+id/ask_distance" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="56dp" android:text="@string/ask_distance" android:textAllCaps="false" />
            <Button android:id="@+id/ask_wrong" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="56dp" android:text="@string/ask_wrong" android:textAllCaps="false" />
            <Button android:id="@+id/ask_eta" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="56dp" android:text="@string/ask_eta" android:textAllCaps="false" />

            <TextView android:id="@+id/log" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:fontFamily="monospace" android:textColor="@color/muted"
                android:textIsSelectable="true" android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
