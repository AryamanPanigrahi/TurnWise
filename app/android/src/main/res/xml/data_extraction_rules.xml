<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the phone in a backup or a device transfer: the app's settings hold the API token
     and the consent record. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
